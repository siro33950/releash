{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "automerge": true,
  "automergeType": "pr",
  "gitIgnoredAuthors": ["/^\\d+\\+releash-dependency-updates\\[bot\\]@users\\.noreply\\.github\\.com$/"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^nx\\.json$/"],
      "matchStrings": [
        "\"installation\"\\s*:\\s*\\{\\s*\"version\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "nx",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["xcodegen", "swift"],
      "automerge": false
    },
    {
      "matchManagers": ["rust-toolchain"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["xcodegen", "swift"],
      "matchPackageNames": ["apple/swift-protobuf"],
      "groupName": "swift-protobuf"
    },
    {
      "matchManagers": ["xcodegen", "swift"],
      "matchPackageNames": ["connectrpc/connect-swift"],
      "groupName": "connect-swift"
    },
    {
      "matchPackageNames": ["nx"],
      "groupName": "Nx",
      "separateMultipleMajor": true,
      "automerge": false
    }
  ]
}
