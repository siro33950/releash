{
	"name": "releash",
	"private": true,
	"version": "0.4.19",
	"license": "(MIT OR Apache-2.0)",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"generate:protocol": "protoc --proto_path=../../proto --plugin=protoc-gen-es=node_modules/.bin/protoc-gen-es --es_out=src/generated --es_opt=target=ts ../../proto/client.proto ../../proto/client_options.proto && node scripts/generate-client-protocol.mjs && biome check --write src/generated/client_pb.ts src/generated/client_options_pb.ts src/generated/client_types.ts src/generated/client_commands.ts",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"tauri:dev": "tauri dev --config tauri.conf.dev.json",
		"tauri:build": "tauri build --config tauri.conf.bundle.json --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
		"lint": "biome ci .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "playwright test --project integration --pass-with-no-tests",
		"test:integration:ui": "playwright test --project integration --ui --pass-with-no-tests",
		"test:behavior": "playwright test --project behavior --pass-with-no-tests"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.16.0",
		"@connectrpc/connect": "^2.2.0",
		"@connectrpc/connect-web": "^2.2.0",
		"@react-symbols/icons": "^1.4.1",
		"@shikijs/langs": "^4.5.0",
		"@shikijs/themes": "^4.5.0",
		"@tanstack/react-virtual": "^3.14.13",
		"@tauri-apps/api": "^2.12.1",
		"@tauri-apps/plugin-dialog": "^2.8.1",
		"@tauri-apps/plugin-opener": "^2.7.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/xterm": "^6.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"lucide-react": "^1.52.0",
		"monaco-editor": "0.57.0",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.14.2",
		"rehype-highlight": "^7.0.2",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.5.0",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@bufbuild/protoc-gen-es": "^2.16.0",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.12.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^5.0.3",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	}
}
