{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Releash Performance",
  "identifier": "com.releash.app.performance",
  "build": {
    "beforeBuildCommand": "pnpm build:performance"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": true,
        "title": "Releash Performance",
        "width": 1440,
        "height": 900,
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "security": {
      "capabilities": [
        "normal-workbench",
        {
          "identifier": "performance-wdio",
          "description": "Performance-build-only WebDriver access for the real Tauri IPC acceptance harness.",
          "windows": ["main"],
          "permissions": ["wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false
  }
}
