{
  "installation": {
    "version": "23.3.0"
  },
  "$schema": "./.nx/installation/node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "rust"
      ],
      "cache": false
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "rust"
      ],
      "cache": false
    },
    "build": {
      "inputs": [
        "default",
        "^default",
        "rust"
      ],
      "cache": false
    }
  },
  "neverConnectToCloud": true,
  "defaultBase": "main",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/mise.toml",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/.nx/nxw.js",
      "{workspaceRoot}/.github/workflows/**/*",
      {
        "runtime": "node -p \"process.platform + process.arch\""
      }
    ],
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "rust": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/**/*",
      "{workspaceRoot}/proto/**/*",
      "{workspaceRoot}/workflows/**/*",
      {
        "env": "CARGO_PROFILE_DEV_DEBUG"
      },
      {
        "env": "RUSTFLAGS"
      },
      {
        "env": "CARGO_TARGET_DIR"
      }
    ]
  }
}
