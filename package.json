{
	"name": "releash",
	"private": true,
	"version": "0.3.27",
	"license": "(MIT OR Apache-2.0)",
	"type": "module",
	"scripts": {
		"predev": "pnpm build:bridge",
		"dev": "concurrently --kill-others \"vite build --watch --config vite.config.remote.ts\" \"vite\"",
		"build": "tsc && vite build && pnpm build:remote && pnpm build:bridge",
		"build:bridge": "node scripts/build-bridge.mjs",
		"build:remote": "vite build --config vite.config.remote.ts",
		"preview": "vite preview",
		"tauri": "tauri",
		"tauri:dev": "tauri dev --config src-tauri/tauri.conf.dev.json",
		"tauri:build": "tauri build --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "playwright test",
		"test:integration:ui": "playwright test --ui",
		"test:screenshots": "playwright test --config playwright.screenshot.config.ts",
		"test:screenshots:update": "playwright test --config playwright.screenshot.config.ts --update-snapshots"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.2.119",
		"@aptabase/tauri": "github:aptabase/tauri-plugin-aptabase",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@noble/hashes": "^2.2.0",
		"@openai/codex-sdk": "^0.128.0",
		"@react-symbols/icons": "^1.3.1",
		"@sentry/react": "^10",
		"@shikijs/langs": "^4.0.2",
		"@shikijs/themes": "^4.0.2",
		"@tanstack/react-virtual": "^3.13.26",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-autostart": "^2.5.1",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-fs": "^2.5.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"diff": "^8.0.3",
		"dompurify": "^3.4.7",
		"highlight.js": "^11.11.1",
		"html5-qrcode": "^2.3.8",
		"lucide-react": "^1.17.0",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.7.4",
		"rehype-highlight": "^7.0.2",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.1.0",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@playwright/test": "^1.60.0",
		"@sentry/vite-plugin": "^5",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "^2.11.2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/diff": "^8.0.0",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "^4.0.18",
		"concurrently": "^10.0.0",
		"esbuild": "^0.28.0",
		"jsdom": "^29.1.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.2",
		"vite": "^8.0.14",
		"vitest": "^4.0.18"
	}
}
