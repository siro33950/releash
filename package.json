{
	"name": "releash",
	"private": true,
	"version": "0.2.9",
	"license": "(MIT OR Apache-2.0)",
	"type": "module",
	"scripts": {
		"dev": "concurrently --kill-others \"vite build --watch --config vite.config.remote.ts\" \"vite\"",
		"build": "tsc && vite build && pnpm build:remote",
		"build:remote": "vite build --config vite.config.remote.ts",
		"preview": "vite preview",
		"tauri": "tauri",
		"tauri:build": "tauri build --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "playwright test",
		"test:integration:ui": "playwright test --ui",
		"test:screenshots": "playwright test --config playwright.screenshot.config.ts",
		"test:screenshots:update": "playwright test --config playwright.screenshot.config.ts --update-snapshots"
	},
	"dependencies": {
		"@aptabase/tauri": "github:aptabase/tauri-plugin-aptabase",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@monaco-editor/react": "4.8.0-rc.3",
		"@noble/hashes": "^2.0.1",
		"@react-symbols/icons": "^1.3.0",
		"@sentry/react": "^10",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-autostart": "^2",
		"@tauri-apps/plugin-dialog": "^2",
		"@tauri-apps/plugin-fs": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.10.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"diff": "^8.0.3",
		"dompurify": "^3.3.1",
		"highlight.js": "^11.11.1",
		"html5-qrcode": "^2.3.8",
		"lucide-react": "^0.575.0",
		"monaco-editor": "0.55.1",
		"radix-ui": "^1.4.3",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.7.2",
		"rehype-highlight": "^7.0.2",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.4",
		"@playwright/test": "^1.58.2",
		"@sentry/vite-plugin": "^5",
		"@tailwindcss/vite": "^4.2.1",
		"@tauri-apps/cli": "^2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/diff": "^8.0.0",
		"@types/node": "^25.3.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^5.1.4",
		"@vitest/coverage-v8": "^4.0.18",
		"concurrently": "^9.2.1",
		"jsdom": "^28.1.0",
		"tailwindcss": "^4.2.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.9.3",
		"vite": "^7.0.4",
		"vitest": "^4.0.18"
	}
}
