{
	"name": "releash",
	"private": true,
	"version": "0.4.0",
	"license": "(MIT OR Apache-2.0)",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"build:performance": "tsc && vite build --mode performance",
		"preview": "vite preview",
		"tauri": "tauri",
		"tauri:dev": "tauri dev --config src-tauri/tauri.conf.dev.json",
		"tauri:build": "tauri build --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:performance": "pnpm build && playwright test --config playwright.performance.config.ts",
		"test:performance:tauri": "pnpm tauri build --no-bundle --features performance-wdio --config src-tauri/tauri.conf.performance.json && wdio run wdio.performance.conf.ts",
		"test:performance:launch:fixture": "RELEASH_PERFORMANCE_LAUNCH_PROVIDER=fixture wdio run wdio.performance.conf.ts",
		"test:performance:launch:tui-fixture": "RELEASH_PERFORMANCE_LAUNCH_PROVIDER=tui-fixture wdio run wdio.performance.conf.ts",
		"test:performance:launch:claude": "RELEASH_PERFORMANCE_LAUNCH_PROVIDER=claude wdio run wdio.performance.conf.ts",
		"test:performance:launch:codex": "RELEASH_PERFORMANCE_LAUNCH_PROVIDER=codex wdio run wdio.performance.conf.ts",
		"test:performance:launch": "pnpm tauri build --no-bundle --features performance-wdio --config src-tauri/tauri.conf.performance.json && pnpm test:performance:launch:fixture && pnpm test:performance:launch:claude && pnpm test:performance:launch:codex",
		"test:performance:real-app": "RELEASH_PERFORMANCE_REAL_APP=1 wdio run wdio.performance.conf.ts",
		"test:watch": "vitest",
		"test:integration": "playwright test",
		"test:integration:ui": "playwright test --ui"
	},
	"dependencies": {
		"@react-symbols/icons": "^1.4.1",
		"@shikijs/langs": "^4.4.2",
		"@shikijs/themes": "^4.3.1",
		"@tanstack/react-virtual": "^3.14.8",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-autostart": "^2.5.1",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-webgl": "0.20.0-beta.286",
		"@xterm/xterm": "^6.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"lucide-react": "^1.27.0",
		"monaco-editor": "0.56.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.12.2",
		"rehype-highlight": "^7.0.2",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.3.1",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.11.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/coverage-v8": "^4.1.10",
		"@wdio/cli": "^9.30.1",
		"@wdio/local-runner": "^9.30.1",
		"@wdio/mocha-framework": "^9.30.1",
		"@wdio/spec-reporter": "^9.30.1",
		"@wdio/tauri-plugin": "^1.3.0",
		"@wdio/tauri-service": "^1.3.0",
		"esbuild": "^0.28.1",
		"jsdom": "^29.1.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
